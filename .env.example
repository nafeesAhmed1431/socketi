# Single app (used if SOCKETI_APPS_JSON / SOCKETI_APPS_FILE not set)
SOCKETI_APP_ID=app1
SOCKETI_APP_KEY=app1key
SOCKETI_APP_SECRET=app1secret

# Multi-app instead: JSON array of { id, key, secret, maxConnections?, enableClientMessages?, maxPresenceMembers?, webhooks?: [{url, secret?, events?}] }
# SOCKETI_APPS_JSON=[{"id":"app1","key":"app1key","secret":"app1secret"}]
# SOCKETI_APPS_FILE=./apps.json

SOCKETI_PORT=6001
SOCKETI_HOST=0.0.0.0
SOCKETI_NODE_ID=

# local | redis (redis required to run more than one socketi instance)
SOCKETI_ADAPTER=local
SOCKETI_REDIS_URL=redis://127.0.0.1:6379

# TLS (leave blank to serve plain ws/http)
SOCKETI_TLS_CERT=
SOCKETI_TLS_KEY=

SOCKETI_MAX_PAYLOAD_KB=64
SOCKETI_AUTH_TOLERANCE_SEC=600
SOCKETI_RATE_LIMIT_MSGS=50
SOCKETI_RATE_LIMIT_WINDOW_MS=10000
SOCKETI_HEARTBEAT_MS=30000
SOCKETI_LOG_LEVEL=info
